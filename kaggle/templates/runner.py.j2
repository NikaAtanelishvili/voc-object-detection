"""Kaggle kernel runner, generated by scripts/kaggle_run.py from kaggle/templates/runner.py.j2.

Clones the repo at an exact commit, installs it without touching Kaggle's preinstalled torch, runs one
command, and records what ran in /kaggle/working/<run_id>/kaggle_run.json. Only /kaggle/working is
saved by Kaggle, so everything the run produces must go into RUN_DIR.
"""

import json
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

REPO_URL = {{ repo_url | tojson }}
COMMIT_SHA = {{ commit_sha | tojson }}
RUN_ID = {{ run_id | tojson }}
COMMAND = {{ command | tojson }}
PIP_PACKAGES = {{ pip | tojson }}
GPU_REQUESTED = {{ "True" if gpu else "False" }}

RUN_DIR = Path("/kaggle/working") / RUN_ID
# Outside /kaggle/working so the clone is not saved as kernel output.
REPO_DIR = Path("/tmp/vocdet-repo")


def run(args: list[str], cwd: Path | None = None) -> None:
    print("+", " ".join(args), flush=True)
    subprocess.run(args, cwd=cwd, check=True)


def run_command_with_log(command: str, cwd: Path, log_path: Path) -> int:
    """Run the job command, echoing output to the kernel log and to log_path."""
    print("+", command, flush=True)
    with log_path.open("w", encoding="utf-8") as log:
        proc = subprocess.Popen(
            command, shell=True, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True
        )
        for line in proc.stdout:
            sys.stdout.write(line)
            log.write(line)
        return proc.wait()


def main() -> int:
    RUN_DIR.mkdir(parents=True, exist_ok=True)
    started = datetime.now(timezone.utc)
    t0 = time.monotonic()

    run(["git", "clone", "--quiet", REPO_URL, str(REPO_DIR)])
    run(["git", "checkout", "--quiet", COMMIT_SHA], cwd=REPO_DIR)
    run([sys.executable, "-m", "pip", "install", "--quiet", "--no-deps", "-e", str(REPO_DIR)])
    if PIP_PACKAGES:
        run([sys.executable, "-m", "pip", "install", "--quiet", *PIP_PACKAGES])

    returncode = run_command_with_log(COMMAND, cwd=REPO_DIR, log_path=RUN_DIR / "command.log")

    meta = {
        "run_id": RUN_ID,
        "repo_url": REPO_URL,
        "commit_sha": COMMIT_SHA,
        "command": COMMAND,
        "pip_packages": PIP_PACKAGES,
        "gpu_requested": GPU_REQUESTED,
        "python": sys.version,
        "started_utc": started.isoformat(),
        "ended_utc": datetime.now(timezone.utc).isoformat(),
        "wall_time_s": round(time.monotonic() - t0, 1),
        "returncode": returncode,
    }
    (RUN_DIR / "kaggle_run.json").write_text(json.dumps(meta, indent=2), encoding="utf-8")
    print(json.dumps(meta, indent=2))
    return returncode


if __name__ == "__main__":
    sys.exit(main())
