# Copy to .env and fill in. .env is gitignored; only this template is committed.
# Hugging Face write token (Settings -> Access Tokens) and username.
HF_TOKEN=
HF_USERNAME=
# Kaggle username. The API token itself lives in ~/.kaggle/ (see docs/ENVIRONMENT.md).
KAGGLE_USERNAME=
# Optional: Weights & Biases.
# WANDB_API_KEY=
